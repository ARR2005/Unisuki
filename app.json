{
  "expo": {
    "name": "Unisuki",
    "slug": "Unisuki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon/dashboardLogo.png",
    "scheme": "unisuki",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.Unisukiteam.Unisuki"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon/dashboardLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyCbMJqiZrow34V2Nuk1s5OseLAACL3aBfs",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "unisukiserver.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "unisukiserver",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "unisukiserver.firebasestorage.app",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "449993955233",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:449993955233:web:cd2f9ebc564163975e1de0",
      "EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-8131BBHX62",
      "router": {},
      "EXPO_PUBLIC_FIREBASE_DATABASE_URL": "https://unisukiserver-default-rtdb.asia-southeast1.firebasedatabase.app",
      "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "unisukiAsset",
      "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "unisuk_posts",
      "eas": {
        "projectId": "268c3702-9679-46c1-894b-9f1d3384ac81"
      }
    }
  }
}
